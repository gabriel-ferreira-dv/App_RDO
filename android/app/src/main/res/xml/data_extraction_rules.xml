<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 ou mais novo: nada do app vai pro backup do Google nem passa
     pro celular novo na transferência. Se o banco e o id do aparelho fossem
     copiados, os dois celulares mandariam registros com o mesmo id e o
     servidor ficaria só com um deles. O histórico volta do servidor no login. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
